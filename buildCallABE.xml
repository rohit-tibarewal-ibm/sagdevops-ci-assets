<project name="Build" default="buildWM" basedir=".">
        
        <property name="abeHome" value="${SAGHome}/common/AssetBuildEnvironment"/>
        
        <property name="abeBuildfileDir" value="master_build"/>

        <property name="abeBuildfileFile" value="build.xml"/>

		<property name="abeBuildPropertiesBasePath" value="master_build_Reference"/>

	<target name="buildWM" description="build project" depends="cleanupBuild">				
		<echo>invoke ABE Build — BUILD_PROPS_LOCATION=${basedir}/${abeBuildPropertiesBasePath}</echo>		
		<ant antfile="${abeBuildfileFile}" dir="${abeHome}/${abeBuildfileDir}" target="build">
			<env key="BUILD_PROPS_LOCATION" value="${basedir}/${abeBuildPropertiesBasePath}"/>
		</ant>
	</target>
	
	<target name="cleanupBuild">			
		<if>
			<available file="${buildOutputDir}" type="dir"/>
			<then>
				<delete includeemptydirs="true">
					<fileset dir="${buildOutputDir}" includes="**/*"/>
				</delete>	
			</then>
		</if>
	</target>
	
	<!-- prepareABEproperties removed — BUILD_PROPS_LOCATION handles
         property injection without touching any product file -->
	
</project>